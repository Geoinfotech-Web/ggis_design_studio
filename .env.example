# GIS Design Studio v1 — configuration.
# Copy this file to `.env` and fill it in. `.env` is ignored by git.
# Full reference: docs/DEPLOYMENT.md → "Configuration".

# ---------------------------------------------------------------------------
# Browser app (baked in at build time — rebuild after changing; none are secret)
# ---------------------------------------------------------------------------

# Sign in with Google. Leave empty to offer email + password only.
#
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. "Create credentials" → "OAuth client ID". If asked for a consent screen,
#    choose "External" and fill in the app name and your email.
# 3. Application type: "Web application".
# 4. Authorised JavaScript origins: add every address the studio is opened at,
#    exactly — http://localhost:5173 for development, and https://your-domain
#    when hosted. No redirect URI is needed.
# 5. Paste the client ID below (it ends in .apps.googleusercontent.com).
#
# The client ID is public by design. There is no client secret to add.
VITE_GOOGLE_CLIENT_ID=

# Where the geodata cache is reached from the browser. Default /api/cache,
# which the dev server and the production nginx both route.
# VITE_CACHE_URL=/api/cache

# Optional AI assistant backend (server/ai-backend.mjs). Leave empty and users
# can still paste a URL into the AI assistant panel, or use the built-in summary.
# VITE_AI_ENDPOINT=

# ---------------------------------------------------------------------------
# Account server (server/account-server.mjs) — read at start-up
# ---------------------------------------------------------------------------
# GOOGLE_CLIENT_ID=            # defaults to VITE_GOOGLE_CLIENT_ID above
# ACCOUNTS_DB=server/data/accounts.db
# COOKIE_SECURE=1              # REQUIRED in production (HTTPS)
# TRUST_PROXY=1                # set when behind nginx / a load balancer
# MAX_PROJECT_BYTES=26214400   # largest saved map, in bytes (25 MB)

# ---------------------------------------------------------------------------
# Geodata cache server (server/cache-server.mjs)
# ---------------------------------------------------------------------------
# CACHE_DB=server/data/geodata.db
# WORLD_DB=server/data/world.db
# CACHE_BUDGET=8589934592      # bytes the cache may grow to before pruning (8 GB)
# ALLOW_ORIGIN=http://localhost:5173   # only for direct (non-proxied) browser calls

# ---------------------------------------------------------------------------
# AI assistant backend (server/ai-backend.mjs) — the key never reaches a browser
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
